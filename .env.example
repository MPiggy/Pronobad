# ---- Database (Supabase → Project Settings → Database → Connection string) ----
#
# Use the *pooler* host for both. The direct host (db.PROJECT_REF.supabase.co)
# resolves IPv6-only and is unreachable from Vercel, which has no IPv6 outbound.

# Transaction pooler, port 6543. Used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler, port 5432. Used by migrations, which need session-level
# features the transaction pooler does not support.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth (Project Settings → API Keys) ----

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# The publishable key (sb_publishable_…). Public by design — it is safe in
# client code and is the successor to the legacy `anon` key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---- App ----

# Used to build magic-link redirect URLs. On Vercel, set this to your
# deployment URL (https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email promoted to superadmin by `npm run db:seed`. See PLAN.md — the first
# superadmin cannot be created through the app, since no admin exists yet.
# The account need not exist yet: the seed pre-creates the row, and it is
# claimed automatically the first time that address signs in.
SUPERADMIN_EMAIL="you@example.com"

# Set to "true" to have `npm run db:seed` also create demo clubs, teams and
# fixtures. Handy locally; leave unset in production.
SEED_DEMO_DATA="false"
