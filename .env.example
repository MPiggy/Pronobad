# ---- Database (Supabase → Project Settings → Database → Connection string) ----

# Pooled connection (PgBouncer, port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Used by migrations — these must not go
# through the pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth (Project Settings → API) ----

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---- App ----

# Used to build magic-link redirect URLs. On Vercel, set this to your
# deployment URL (https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email promoted to superadmin by `npm run db:seed`. See PLAN.md — the first
# superadmin cannot be created through the app, since no admin exists yet.
SUPERADMIN_EMAIL="you@example.com"
